# Copy this file to .env and fill in your own values from Supabase (Project Settings -> API).
# Only the publishable (anon / public) key goes here. Never put the secret / service_role key in this app.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Where people write to see or delete their data (shown on the privacy page)
VITE_PRIVACY_EMAIL=you@example.com
